          "cached_tokens": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Cached Tokens",
            "type": "integer"
          },
          "completion_tokens": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Completion Tokens",
            "type": "integer"
