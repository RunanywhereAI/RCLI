          "message": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApiErrorCode": {
        "enum": [
          "invalid_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "gone",
          "payload_too_large",
          "rate_limited",
          "internal_error",
          "upstream_unavailable",
          "service_unavailable",
          "timeout",
          "bad_request",
          "expired_api_key",
          "gateway_unavailable",
          "idempotency_key_reused",
          "insufficient_credit",
          "invalid_api_key",
          "model_not_entitled",
          "not_in_cohort",
          "provisioning_unavailable",
          "proxy_retired",
          "revoked_api_key",
          "signup_method_not_allowed",
          "upstream_contract_violation",
          "user_rate_limited",
          "gateway_not_configured",
          "gateway_timeout",
          "gateway_protocol_error",
          "gateway_operation_pending",
          "reconciliation_unverified"
